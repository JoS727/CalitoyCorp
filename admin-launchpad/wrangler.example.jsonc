{
  "name": "calitoy-admin-hub",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-10",
  "workers_dev": false,
  "preview_urls": false,
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "kv_namespaces": [{ "binding": "INVENTORY", "id": "REPLACE_WITH_PRIVATE_KV_NAMESPACE_ID" }],
  "vars": { "ADMIN_ALLOWED_EMAILS": "REPLACE_WITH_OWNER_APPROVED_EMAIL" }
  // Deliberately no assets binding and no domain route until Access is enabled.
  // After enabling Worker-level Access and verifying the owner can sign in,
  // attach admin.calitoy.com as the Custom Domain in the Cloudflare dashboard.
}
